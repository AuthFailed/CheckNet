    "Кнопка ⓘ у каждой проверки — простыми словами": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زر ⓘ عند كل فحص — بكلمات بسيطة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ⓘ-Knopf bei jeder Prüfung — in einfachen Worten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ⓘ button on every check — in plain words"
