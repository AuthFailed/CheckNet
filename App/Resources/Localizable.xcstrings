        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre seus arquivos `geosite.dat` / `geoip.dat`: categorias e tags, busca de domínio/IP por categorias, filtros e ordenação, exportação."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`geosite.dat` / `geoip.dat` 파일을 엽니다: 카테고리와 태그, 카테고리별 도메인/IP 검색, 필터 및 정렬, 내보내기."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre i tuoi file `geosite.dat` / `geoip.dat`: categorie e tag, ricerca di dominio/IP per categoria, filtri e ordinamento, esportazione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`geosite.dat` / `geoip.dat` dosyalarınızı açar: kategoriler ve etiketler, kategorilere göre alan adı/IP arama, filtreler ve sıralama, dışa aktarma."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح ملفاتك `geosite.dat` / `geoip.dat`: الفئات والوسوم، والبحث عن نطاق/IP حسب الفئات، والتصفية والفرز، والتصدير."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी `geosite.dat` / `geoip.dat` फ़ाइलें खोलता है: श्रेणियाँ और टैग, श्रेणियों में डोमेन/IP खोज, फ़िल्टर और सॉर्टिंग, एक्सपोर्ट।"
          }
        }
      }
    },
