    "Запрашиваем сайт по HTTP и ищем в ответе маркеры страницы блокировки («Доступ ограничен», «Роскомнадзор», 149-ФЗ).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نطلب الموقع عبر HTTP ونبحث في الاستجابة عن علامات صفحة الحجب («تم تقييد الوصول»، «Roskomnadzor»، القانون 149)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir rufen die Website über HTTP ab und suchen in der Antwort nach Merkmalen einer Sperrseite (‚Zugriff eingeschränkt‘, ‚Roskomnadsor‘, Gesetz 149-FZ)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We request the site over HTTP and look for block-page markers in the response (“Access restricted”, “Roskomnadzor”, Federal Law 149-FZ)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicita el sitio por HTTP y se buscan en la respuesta marcadores de una página de bloqueo (“Acceso restringido”, “Roskomnadzor”, ley 149-FZ)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous interrogeons le site en HTTP et cherchons dans la réponse les marqueurs d’une page de blocage (« Accès restreint », « Roskomnadzor », loi 149-FZ)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइट को HTTP से अनुरोध करके जवाब में ब्लॉक पेज के मार्कर खोजे जाते हैं (\"एक्सेस प्रतिबंधित\", \"Roskomnadzor\", 149-FZ)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiediamo il sito via HTTP e cerchiamo nella risposta i marcatori di una pagina di blocco (“Accesso limitato”, “Roskomnadzor”, legge 149-FZ)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトに HTTP でアクセスし、応答にブロックページの目印（「アクセス制限」、「Roskomnadzor」、連邦法149号）が含まれるかを調べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트를 HTTP로 요청하고 응답에 차단 페이지 표식('접근 제한', 'Roskomnadzor', 연방법 149호)이 있는지 확인해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitamos o site via HTTP e procuramos na resposta marcadores de uma página de bloqueio (“Acesso restrito”, “Roskomnadzor”, lei 149-FZ)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siteyi HTTP üzerinden isteyip yanıtta engelleme sayfası izlerini arıyoruz (“Erişim kısıtlandı”, “Roskomnadzor”, 149 sayılı kanun)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 HTTP 请求网站，并在响应中查找封锁页面的标记（“访问受限”、“Roskomnadzor”、149 号联邦法）。"
          }
        }
      }
    },
    "Запрашивает данные о регистрации домена: регистратор, даты, серверы имён. Помогает узнать, кому принадлежит домен.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب بيانات تسجيل النطاق: المسجّل، التواريخ، خوادم الأسماء. يساعد على معرفة مالك النطاق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt die Registrierungsdaten der Domain ab: Registrar, Daten, Nameserver. Hilft herauszufinden, wem die Domain gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests domain registration data: registrar, dates, name servers. Helps find out who owns the domain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los datos de registro del dominio: registrador, fechas, servidores de nombres. Ayuda a saber a quién pertenece el dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère les données d'enregistrement du domaine : bureau d'enregistrement, dates, serveurs de noms. Permet de savoir à qui appartient le domaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डोमेन पंजीकरण डेटा प्राप्त करता है: रजिस्ट्रार, तिथियाँ, नाम सर्वर। यह जानने में मदद करता है कि डोमेन किसका है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede i dati di registrazione del dominio: registrar, date, server dei nomi. Aiuta a scoprire a chi appartiene il dominio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメインの登録情報（レジストラ、日付、ネームサーバー）を照会します。ドメインの所有者を確認するのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도메인 등록 정보(등록 기관, 날짜, 네임 서버)를 조회합니다. 도메인 소유자를 확인하는 데 유용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta os dados de registro do domínio: registrador, datas, servidores de nomes. Ajuda a descobrir a quem pertence o domínio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alan adı kayıt bilgilerini sorgular: kayıt kuruluşu, tarihler, ad sunucuları. Alan adının kime ait olduğunu öğrenmeye yardımcı olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询域名的注册信息：注册商、日期、名称服务器。帮助了解域名归属。"
          }
        }
      }
    },
    "Запрашивает у DNS все типы записей домена (A, AAAA, MX, TXT и др.) и показывает задержку резолвера. Базовая диагностика доменных имён.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب من DNS جميع أنواع سجلات النطاق (A، AAAA، MX، TXT وغيرها) ويعرض تأخير المحلّل. تشخيص أساسي لأسماء النطاقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt beim DNS alle Eintragstypen der Domain ab (A, AAAA, MX, TXT usw.) und zeigt die Resolver-Latenz. Grundlegende Diagnose von Domainnamen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queries DNS for all record types of a domain (A, AAAA, MX, TXT, etc.) and shows resolver latency. Basic domain-name diagnostics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta al DNS todos los tipos de registro del dominio (A, AAAA, MX, TXT, etc.) y muestra la latencia del resolutor. Diagnóstico básico de nombres de dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge le DNS pour tous les types d'enregistrements du domaine (A, AAAA, MX, TXT, etc.) et affiche la latence du résolveur. Diagnostic de base des noms de domaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS से डोमेन के सभी रिकॉर्ड प्रकार (A, AAAA, MX, TXT आदि) माँगता है और रिज़ॉल्वर विलंब दिखाता है। डोमेन नामों की बुनियादी जाँच।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede al DNS tutti i tipi di record del dominio (A, AAAA, MX, TXT ecc.) e mostra la latenza del resolver. Diagnostica di base dei nomi di dominio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS にドメインの全レコードタイプ（A、AAAA、MX、TXT など）を照会し、リゾルバの遅延を表示します。ドメイン名の基本診断です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS에 도메인의 모든 레코드 유형(A, AAAA, MX, TXT 등)을 조회하고 리졸버 지연을 표시합니다. 도메인 이름의 기본 진단입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta no DNS todos os tipos de registro do domínio (A, AAAA, MX, TXT etc.) e mostra a latência do resolvedor. Diagnóstico básico de nomes de domínio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS'ten alan adının tüm kayıt türlerini (A, AAAA, MX, TXT vb.) sorgular ve çözümleyici gecikmesini gösterir. Temel alan adı tanılaması."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 DNS 查询域名的所有记录类型（A、AAAA、MX、TXT 等）并显示解析器延迟。域名的基础诊断。"
          }
        }
      }
    },
    "Запросим подписку от лица разных клиентов и покажем, что сервер отдаёт каждому: узлы, формат, лимиты и имя файла.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll request the subscription as different clients and show what the server returns to each: nodes, format, limits and file name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以不同客户端身份请求订阅，展示服务器返回给每一个客户端的内容：节点、格式、限额和文件名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitaremos la suscripción en nombre de distintos clientes y mostraremos lo que el servidor entrega a cada uno: nodos, formato, límites y nombre de archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous demanderons l'abonnement au nom de différents clients et montrerons ce que le serveur renvoie à chacun : nœuds, format, limites et nom de fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir fragen das Abo im Namen verschiedener Clients ab und zeigen, was der Server jedem liefert: Nodes, Format, Limits und Dateiname."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さまざまなクライアントとしてサブスクリプションを要求し、サーバーが各クライアントに返す内容 (ノード、フォーマット、制限、ファイル名) を表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitamos a assinatura em nome de diferentes clientes e mostramos o que o servidor entrega a cada um: nós, formato, limites e nome do arquivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 클라이언트 입장에서 구독을 요청하여 서버가 각각에게 무엇을 반환하는지 보여줍니다: 노드, 형식, 제한, 파일 이름."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiediamo l'abbonamento a nome di diversi client e mostriamo cosa il server fornisce a ciascuno: nodi, formato, limiti e nome del file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliği farklı istemciler adına isteyip sunucunun her birine ne verdiğini gösteririz: düğümler, format, limitler ve dosya adı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنطلب الاشتراك باسم عملاء مختلفين ونعرض ما يعطيه الخادم لكل منهم: العُقد، التنسيق، الحدود، واسم الملف."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम अलग-अलग क्लाइंट की ओर से सदस्यता का अनुरोध करेंगे और दिखाएंगे कि सर्वर हर एक को क्या देता है: नोड, फ़ॉर्मेट, सीमाएँ और फ़ाइल का नाम।"
          }
        }
      }
    },
