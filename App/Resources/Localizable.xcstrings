    "Сервер вернул неизвестный формат — попробуйте другой User-Agent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned an unknown format — try a different User-Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了未知格式 — 请尝试其他 User-Agent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor devolvió un formato desconocido — prueba con otro User-Agent"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé un format inconnu — essayez un autre User-Agent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server hat ein unbekanntes Format zurückgegeben — versuchen Sie einen anderen User-Agent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが不明な形式を返しました — 別のUser-Agentをお試しください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor retornou um formato desconhecido — tente outro User-Agent"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 알 수 없는 형식을 반환함 — 다른 User-Agent를 사용해 보세요"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha restituito un formato sconosciuto — prova un altro User-Agent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bilinmeyen bir format döndürdü — farklı bir User-Agent deneyin"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد الخادم تنسيقًا غير معروف — جرّب User-Agent آخر"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने अज्ञात फ़ॉर्मैट लौटाया — कोई दूसरा User-Agent आज़माएँ"
          }
        }
      }
    },
    "Сервер не завершил рукопожатие на одном X25519 — Reality опирается на эту кривую.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't complete the handshake on X25519 alone — Reality relies on this curve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未能仅用 X25519 完成握手 — Reality 依赖该曲线。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no completó el handshake solo con X25519 — Reality depende de esa curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas terminé le handshake sur X25519 seul — Reality repose sur cette courbe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server hat den Handshake mit nur X25519 nicht abgeschlossen — Reality stützt sich auf diese Kurve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはX25519単独でハンドシェイクを完了しませんでした — Realityはこの曲線に依存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não concluiu o handshake apenas com X25519 — o Reality depende dessa curva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 X25519만으로 handshake를 완료하지 못했습니다 — Reality는 이 곡선에 의존합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha completato l'handshake con solo X25519 — Reality si basa su questa curva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yalnızca X25519 ile handshake'i tamamlamadı — Reality bu eğriye dayanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل الخادم المصافحة على X25519 وحده — يعتمد Reality على هذا المنحنى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने केवल X25519 पर handshake पूरा नहीं किया — Reality इसी कर्व पर निर्भर करता है।"
          }
        }
      }
    },
    "Серверы APNs и FCM отвечают — сеть доставку уведомлений не блокирует.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs and FCM servers respond — the network isn't blocking notification delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs 和 FCM 服务器有响应 — 网络未阻断通知投递。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores APNs y FCM responden — la red no bloquea la entrega de notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs APNs et FCM répondent — le réseau ne bloque pas la livraison des notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs- und FCM-Server antworten — das Netzwerk blockiert die Zustellung von Benachrichtigungen nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APNsとFCMのサーバーが応答しています — ネットワークは通知配信をブロックしていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores APNs e FCM respondem — a rede não bloqueia a entrega de notificações."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs와 FCM 서버가 응답합니다 — 네트워크가 알림 전송을 차단하지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I server APNs e FCM rispondono — la rete non blocca la consegna delle notifiche."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs ve FCM sunucuları yanıt veriyor — ağ bildirim teslimatını engellemiyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خوادم APNs وFCM تستجيب — الشبكة لا تحجب تسليم الإشعارات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs और FCM सर्वर जवाब दे रहे हैं — नेटवर्क सूचना डिलीवरी को ब्लॉक नहीं करता।"
          }
        }
      }
    },
