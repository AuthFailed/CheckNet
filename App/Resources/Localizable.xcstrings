    "http допустим только для localhost — иначе результаты уйдут в открытом виде.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسمح بـ http لـ localhost فقط — وإلا فستُرسل النتائج بنص غير مشفّر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "http ist nur für localhost zulässig – sonst werden die Ergebnisse unverschlüsselt gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "http is allowed for localhost only — otherwise results are sent unencrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "http solo se admite para localhost: de lo contrario, los resultados se enviarán sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "http n’est autorisé que pour localhost — sinon les résultats seront transmis en clair."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "http केवल localhost के लिए मान्य है — वरना परिणाम बिना एन्क्रिप्शन के भेजे जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "http è ammesso solo per localhost: altrimenti i risultati vengono inviati in chiaro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http は localhost の場合のみ使用できます。それ以外では結果が平文で送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http는 localhost에만 사용할 수 있어요. 그 외에는 결과가 평문으로 전송돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "http só é permitido para localhost: caso contrário, os resultados são enviados sem criptografia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "http yalnızca localhost için kabul edilir — aksi hâlde sonuçlar açık metin olarak gönderilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "http 仅允许用于 localhost，否则结果将以明文发送。"
          }
        }
      }
    },
    "HTTP-запрос не вернул тело.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعِد طلب HTTP أي محتوى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HTTP-Anfrage hat keinen Inhalt zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP request returned no body."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud HTTP no devolvió cuerpo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête HTTP n'a renvoyé aucun contenu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP अनुरोध ने कोई बॉडी नहीं लौटाई।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta HTTP non ha restituito un corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP リクエストが本文を返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 요청이 본문을 반환하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A requisição HTTP não retornou corpo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP isteği gövde döndürmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 请求未返回正文。"
          }
        }
      }
    },
    "HTTP-ответ не содержит маркеров страницы блокировки.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي استجابة HTTP على علامات صفحة حجب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HTTP-Antwort enthält keine Merkmale einer Sperrseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP response contains no block-page markers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta HTTP no contiene marcadores de página de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse HTTP ne contient aucun marqueur de page de blocage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP उत्तर में ब्लॉक पेज के कोई चिह्न नहीं हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta HTTP non contiene marcatori di pagina di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 応答にブロックページのマーカーが含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 응답에 차단 페이지 표식이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta HTTP não contém marcadores de página de bloqueio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP yanıtı, engelleme sayfası işaretleri içermiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 响应不包含拦截页面的特征标记。"
          }
        }
      }
    },
