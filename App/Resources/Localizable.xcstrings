            "value": "優秀 — 遅延はほとんど増えません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훌륭함 — 지연이 거의 늘지 않음"
          }
        },
        "pt-BR": {
