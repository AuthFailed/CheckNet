    "Рукопожатие проходит, когда предлагается только X25519.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The handshake succeeds when only X25519 is offered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提供 X25519 时握手成功。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El handshake se completa cuando solo se ofrece X25519."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le handshake réussit quand seul X25519 est proposé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Handshake gelingt, wenn nur X25519 angeboten wird."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X25519のみが提示された場合にハンドシェイクが成立します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O handshake é concluído quando apenas X25519 é oferecido."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "X25519만 제안될 때 handshake가 성공합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'handshake riesce quando viene proposto solo X25519."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca X25519 önerildiğinde handshake başarılı olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنجح المصافحة عند عرض X25519 فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब केवल X25519 पेश किया जाता है तो handshake सफल होता है।"
          }
        }
      }
    },
