    "Чтобы найти устройства в вашей сети, приложению нужен доступ к локальной сети.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للعثور على الأجهزة في شبكتك، يحتاج التطبيق إلى الوصول إلى الشبكة المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Geräte in deinem Netzwerk zu finden, benötigt die App Zugriff auf das lokale Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find devices on your network, the app needs local-network access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para encontrar dispositivos en tu red, la app necesita acceso a la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour trouver les appareils de votre réseau, l'app a besoin de l'accès au réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नेटवर्क के डिवाइस खोजने के लिए ऐप को स्थानीय नेटवर्क तक पहुँच चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per trovare i dispositivi nella tua rete, l'app ha bisogno dell'accesso alla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク上の機器を見つけるため、アプリはローカルネットワークへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크의 기기를 찾으려면 앱에 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "pt-BR": {
