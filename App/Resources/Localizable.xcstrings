            "state": "translated",
            "value": "انتهت مهلة الاتصال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung der Verbindung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection timed out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión expiró"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन का समय समाप्त हुआ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione scaduta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がタイムアウトしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 시간이 초과되었습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão expirou"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı zaman aşımına uğradı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时"
          }
        }
      }
    },
    "Соединение с тем же IP рвётся только при «запрещённом» имени в TLS — это DPI-фильтрация по SNI.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقطع الاتصال بعنوان IP نفسه فقط عندما يكون الاسم في TLS «محظورًا» — وهذه تصفية DPI حسب SNI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zur selben IP wird nur bei einem „gesperrten“ Namen im TLS abgebrochen – das Netzwerk filtert per DPI nach SNI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connection to the same IP is cut off only when the TLS name is a “restricted” one — the network filters by SNI (DPI)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión a la misma IP solo se corta cuando el nombre “prohibido” aparece en TLS: es un filtrado DPI por SNI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec la même IP, la connexion n’est coupée que lorsque le nom « interdit » figure dans TLS — c’est un filtrage DPI par SNI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उसी IP से कनेक्शन केवल तभी टूटता है जब TLS में \"प्रतिबंधित\" नाम हो — यह SNI के आधार पर DPI फ़िल्टरिंग है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione allo stesso IP cade solo con il nome “vietato” in TLS: è filtraggio DPI per SNI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ IP でも TLS の名前が「禁止」対象のときだけ接続が切断されます。SNI による DPI フィルタリングです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 IP라도 TLS 이름이 '금지' 대상일 때만 연결이 끊겨요. SNI 기반 DPI 필터링이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão ao mesmo IP cai apenas com o nome “proibido” no TLS: é filtragem DPI por SNI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı IP’yle bağlantı yalnızca TLS’teki ad “yasaklı” olduğunda kopuyor — bu, SNI’ye göre DPI filtrelemesidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与同一 IP 的连接只有在 TLS 中使用“被禁”名称时才被中断，这是按 SNI 的 DPI 过滤。"
          }
        }
      }
    },
    "соединение сброшено (RST)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعيد تعيين الاتصال (RST)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zurückgesetzt (RST)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "connection reset (RST)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "conexión reiniciada (RST)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "connexion réinitialisée (RST)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन रीसेट (RST)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "connessione resettata (RST)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がリセットされました（RST）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 재설정됨(RST)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "conexão redefinida (RST)"
          }
