    "Ничего не доступно — проверьте подключение.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء متاح — تحقّق من الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist verfügbar – prüfen Sie Ihre Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is reachable — check your connection."
          }
        },
        "es": {
