      }
    },
    "Уровень сигнала Wi-Fi и потери. Ограничено политиками iOS.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوة إشارة Wi-Fi والفقد. مقيّد بسياسات iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi-Signalstärke und Verlust. Durch iOS-Richtlinien eingeschränkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi signal strength and loss. Limited by iOS policies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivel de señal Wi-Fi y pérdidas. Limitado por las políticas de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau du signal Wi-Fi et pertes. Limité par les règles d'iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi सिग्नल स्तर और हानि। iOS नीतियों द्वारा सीमित।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensità del segnale Wi-Fi e perdita. Limitato dalle policy di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi の信号強度と損失。iOS のポリシーにより制限されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 신호 강도와 손실. iOS 정책에 의해 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidade do sinal de Wi-Fi e perdas. Limitado pelas políticas do iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi sinyal gücü ve kayıp. iOS politikalarıyla sınırlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 信号强度与丢包。受 iOS 策略限制。"
          }
        }
      }
    },
    "Уровень сигнала и канал iOS приложениям не сообщает — они доступны в версии для Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't report signal level and channel to apps — they're available in the Mac version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不向应用提供信号强度和信道——它们仅在 Mac 版中可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no comunica el nivel de señal ni el canal a las apps: están disponibles en la versión para Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne communique ni le niveau de signal ni le canal aux apps — ils sont disponibles dans la version Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalstärke und Kanal gibt iOS Apps nicht preis — sie sind in der Mac-Version verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS は信号強度とチャンネルをアプリに提供しません — これらは Mac 版で利用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não informa aos apps o nível do sinal e o canal — eles estão disponíveis na versão para Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 신호 세기와 채널을 앱에 제공하지 않습니다 — Mac 버전에서 확인할 수 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non comunica alle app il livello del segnale e il canale: sono disponibili nella versione per Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, sinyal seviyesini ve kanalı uygulamalara bildirmez — bunlar Mac sürümünde kullanılabilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُبلّغ iOS التطبيقات بمستوى الإشارة والقناة — وهما متاحان في نسخة Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ऐप्स को सिग्नल स्तर और चैनल नहीं बताता — ये Mac वर्शन में उपलब्ध हैं।"
          }
        }
      }
    },
