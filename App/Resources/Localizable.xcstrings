    "Дальше система покажет свой запрос — решение за вами.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ذلك سيعرض النظام طلبه الخاص — القرار لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes zeigt das System seine eigene Abfrage — die Entscheidung liegt bei dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next the system shows its own prompt — the choice is yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después el sistema mostrará su propia solicitud — la decisión es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite le système affichera sa propre demande — le choix vous appartient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद सिस्टम अपना अनुरोध दिखाएगा — निर्णय आपका है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi il sistema mostrerà la propria richiesta — la scelta è tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にシステム自身の確認が表示されます — 決めるのはあなたです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에는 시스템이 자체 요청을 표시합니다 — 선택은 당신의 몫입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida o sistema mostrará seu próprio pedido — a escolha é sua."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ardından sistem kendi istemini gösterir — karar sizin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来系统会弹出自己的请求——决定权在你。"
          }
        }
      }
    },
