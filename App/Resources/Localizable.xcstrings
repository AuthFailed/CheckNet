    "Диагностика выполняется прямо на вашем iPhone. Наружу ничего не уходит — результаты остаются у вас.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري التشخيص على iPhone مباشرةً. لا شيء يغادره — تبقى النتائج لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnose läuft direkt auf deinem iPhone. Nichts verlässt es — die Ergebnisse bleiben bei dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics run right on your iPhone. Nothing leaves it — the results stay with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diagnóstico se ejecuta en tu iPhone. Nada sale de él: los resultados se quedan contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diagnostic s'exécute directement sur votre iPhone. Rien n'en sort — les résultats restent chez vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डायग्नोस्टिक्स सीधे आपके iPhone पर चलते हैं। कुछ भी बाहर नहीं जाता — परिणाम आपके पास रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diagnostica viene eseguita direttamente sul tuo iPhone. Nulla esce — i risultati restano con te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断はあなたの iPhone 上で実行されます。外部には何も出ず、結果は手元に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단은 iPhone에서 바로 실행됩니다. 아무것도 밖으로 나가지 않고 결과는 당신에게 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diagnóstico é executado direto no seu iPhone. Nada sai dele — os resultados ficam com você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama doğrudan iPhone'unuzda çalışır. Hiçbir şey dışarı çıkmaz — sonuçlar sizde kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断就在你的 iPhone 上运行。数据不外传——结果只属于你。"
          }
        }
      }
    },
    "Диагностика и работа с конфигами для владельцев VPN. Приложение не обходит блокировки — оно помогает настроить и проверить свой сервер.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics and config tools for VPN owners. The app doesn't bypass blocks — it helps you set up and check your own server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面向 VPN 拥有者的诊断和配置工具。本应用不用于绕过封锁——它帮助你配置和检测自己的服务器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnóstico y gestión de configuraciones para propietarios de VPN. La app no elude bloqueos: ayuda a configurar y verificar tu propio servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic et gestion des configs pour les propriétaires de VPN. L'app ne contourne pas les blocages — elle aide à configurer et vérifier votre serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose und Arbeit mit Configs für VPN-Betreiber. Die App umgeht keine Sperren — sie hilft, den eigenen Server einzurichten und zu prüfen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 所有者向けの診断と設定管理。このアプリはブロックを回避するものではなく、自分のサーバーの設定と確認を支援します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnóstico e trabalho com configs para donos de VPN. O app não contorna bloqueios — ele ajuda a configurar e testar o seu servidor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 소유자를 위한 진단 및 구성 관리. 이 앱은 차단을 우회하지 않습니다 — 자신의 서버를 설정하고 점검하는 것을 돕습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostica e gestione delle configurazioni per i proprietari di VPN. L'app non aggira i blocchi: aiuta a configurare e verificare il tuo server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN sahipleri için tanılama ve konfigürasyon işlemleri. Uygulama engelleri aşmaz — kendi sunucunuzu kurup kontrol etmenize yardımcı olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشخيص والعمل مع الإعدادات لأصحاب خوادم VPN. التطبيق لا يتجاوز الحجب — بل يساعد على إعداد خادمك والتحقق منه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN मालिकों के लिए डायग्नोस्टिक्स और कॉन्फ़िग के साथ काम। ऐप ब्लॉक को बायपास नहीं करता — यह आपके सर्वर को सेटअप और जाँचने में मदद करता है।"
          }
        }
      }
    },
