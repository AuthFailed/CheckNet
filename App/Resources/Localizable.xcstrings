    "TLS-соединение с «запрещённым» именем проходит нормально.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال TLS باسم «محظور» يتم بنجاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die TLS-Verbindung mit dem „gesperrten“ Namen kommt normal zustande."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TLS connection with the “restricted” name goes through normally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión TLS con un nombre “prohibido” se establece con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion TLS avec un nom « interdit » s’établit normalement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"प्रतिबंधित\" नाम के साथ TLS कनेक्शन सामान्य रूप से बनता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione TLS con il nome “vietato” funziona regolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「禁止」対象の名前を使った TLS 接続も正常に確立します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'금지' 대상 이름으로도 TLS 연결이 정상적으로 이루어져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão TLS com o nome “proibido” funciona normalmente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Yasaklı” ad ile TLS bağlantısı sorunsuz kuruluyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“被禁”名称的 TLS 连接正常建立。"
          }
        }
      }
    },
