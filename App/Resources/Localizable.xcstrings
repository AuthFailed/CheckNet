    "Сервис проверки не принял запрос. Попробуйте позже.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت خدمة الفحص الطلب. حاول لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prüfdienst hat die Anfrage abgelehnt. Später erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check service rejected the request. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de comprobación rechazó la solicitud. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a rejeté la requête. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच सेवा ने अनुरोध अस्वीकार किया। बाद में पुनः प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio ha rifiutato la richiesta. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックサービスが要求を拒否しました。後でやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 서비스가 요청을 거부했습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de verificação recusou a solicitação. Tente mais tarde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol servisi isteği reddetti. Sonra tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测服务拒绝了请求。请稍后再试。"
          }
        }
      }
    },
