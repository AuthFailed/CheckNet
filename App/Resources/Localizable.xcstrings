    "Геопозиция нужна только для чтения имени сети — координаты не сохраняются и не отправляются.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is only needed to read the network name — coordinates are not stored or sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位仅用于读取网络名称——不会保存或发送坐标。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación solo se usa para leer el nombre de la red: las coordenadas no se guardan ni se envían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation ne sert qu'à lire le nom du réseau — les coordonnées ne sont ni enregistrées ni envoyées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird nur zum Auslesen des Netzwerknamens benötigt — Koordinaten werden nicht gespeichert oder gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報はネットワーク名の読み取りにのみ使用されます — 座標は保存も送信もされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização é usada apenas para ler o nome da rede — as coordenadas não são salvas nem enviadas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 정보는 네트워크 이름을 읽는 데만 필요합니다 — 좌표는 저장되거나 전송되지 않습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione serve solo per leggere il nome della rete: le coordinate non vengono salvate né inviate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum yalnızca ağ adını okumak için gerekir — koordinatlar kaydedilmez ve gönderilmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع الجغرافي مطلوب فقط لقراءة اسم الشبكة — الإحداثيات لا تُحفظ ولا تُرسل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन केवल नेटवर्क का नाम पढ़ने के लिए चाहिए — निर्देशांक न सहेजे जाते हैं न भेजे जाते हैं।"
          }
        }
      }
    },
    "Геопозиция нужна только чтобы прочитать имя Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
