    "Проверяет доступность группы узлов — провайдеров, популярных сервисов или серверов push-уведомлений.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص توفر مجموعة من العقد: مزودي الخدمة أو الخدمات الشائعة أو خوادم الإشعارات الفورية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die Erreichbarkeit einer Gruppe von Hosts – Anbieter, beliebte Dienste oder Server für Push-Mitteilungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether a group of hosts is reachable — providers, popular services or push notification servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la accesibilidad de un grupo de hosts: operadores, servicios populares o servidores de notificaciones push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie l’accessibilité d’un groupe d’hôtes : opérateurs, services populaires ou serveurs de notifications push."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोड के एक समूह की उपलब्धता जाँचता है — प्रोवाइडर, लोकप्रिय सेवाएँ या पुश सूचना सर्वर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la raggiungibilità di un gruppo di nodi: provider, servizi popolari o server di notifiche push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダ、主なサービス、プッシュ通知サーバなど、ホストのグループへの到達性を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통신사, 인기 서비스, 푸시 알림 서버 등 호스트 그룹의 연결 상태를 확인해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a disponibilidade de um grupo de nós — provedores, serviços populares ou servidores de notificações push."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düğüm grubunun — sağlayıcıların, popüler servislerin veya anlık bildirim sunucularının — erişilebilirliğini denetler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测一组节点的可达性：运营商、常用服务或推送通知服务器。"
          }
        }
      }
    },
    "Проверяет доступность серверов push-уведомлений (APNs и FCM).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks reachability of push notification servers (APNs and FCM)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测推送通知服务器（APNs 和 FCM）的可用性。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la disponibilidad de los servidores de notificaciones push (APNs y FCM)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la disponibilité des serveurs de notifications push (APNs et FCM)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die Erreichbarkeit der Push-Benachrichtigungsserver (APNs und FCM)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュ通知サーバー (APNs と FCM) の可用性を確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a disponibilidade dos servidores de notificações push (APNs e FCM)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸시 알림 서버(APNs 및 FCM)의 가용성을 점검합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la disponibilità dei server delle notifiche push (APNs e FCM)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push bildirim sunucularının (APNs ve FCM) erişilebilirliğini kontrol eder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص توفّر خوادم الإشعارات الفورية (APNs وFCM)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "push नोटिफ़िकेशन सर्वर (APNs और FCM) की उपलब्धता जाँचता है।"
          }
        }
      }
    },
    "Проверяет доступность хоста из разных точек мира. Требует внешнего сервиса.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص توفّر المضيف من نقاط مختلفة حول العالم. يتطلب خدمة خارجية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die Erreichbarkeit eines Hosts von verschiedenen Orten der Welt aus. Erfordert einen externen Dienst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks a host's reachability from different points around the world. Requires an external service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la disponibilidad del host desde distintos puntos del mundo. Requiere un servicio externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie l'accessibilité d'un hôte depuis différents points du monde. Nécessite un service externe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया के विभिन्न स्थानों से होस्ट की उपलब्धता जाँचता है। इसके लिए बाहरी सेवा आवश्यक है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la raggiungibilità dell'host da diversi punti del mondo. Richiede un servizio esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界各地からのホストの到達性を確認します。外部サービスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세계 여러 지점에서 호스트의 접속 가능 여부를 확인합니다. 외부 서비스가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a disponibilidade do host a partir de diferentes pontos do mundo. Requer um serviço externo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sunucunun dünyanın farklı noktalarından erişilebilirliğini kontrol eder. Harici bir hizmet gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从全球不同地点检查主机的可用性。需要外部服务。"
          }
        }
      }
    },
    "Проверяет доступность хоста с узлов по всему миру — ping, HTTP, TCP, DNS или UDP, с выбором стран. Видно, откуда ресурс доступен, а откуда нет. Проверка выполняется через внешний сервис.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص إمكانية الوصول إلى مضيف من عُقد حول العالم — ping أو HTTP أو TCP أو DNS أو UDP، مع اختيار الدول. ترى من أين يمكن الوصول ومن أين لا. يتم الفحص عبر خدمة خارجية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die Erreichbarkeit eines Hosts von Knoten weltweit – ping, HTTP, TCP, DNS oder UDP, mit Länderauswahl. Du siehst, von wo die Ressource erreichbar ist und von wo nicht. Die Prüfung läuft über einen externen Dienst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks a host’s reachability from nodes around the world — ping, HTTP, TCP, DNS or UDP, with a choice of countries. You see where the resource is reachable and where it isn’t. The check runs through an external service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la accesibilidad de un host desde nodos de todo el mundo —ping, HTTP, TCP, DNS o UDP—, con selección de países. Ves desde dónde es accesible el recurso y desde dónde no. La comprobación se realiza a través de un servicio externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie l’accessibilité d’un hôte depuis des nœuds du monde entier — ping, HTTP, TCP, DNS ou UDP, avec choix des pays. Vous voyez d’où la ressource est accessible et d’où elle ne l’est pas. La vérification passe par un service externe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुनिया भर के नोड से किसी होस्ट की पहुँच जाँचता है — ping, HTTP, TCP, DNS या UDP, देश चुनने के साथ। दिखता है कि संसाधन कहाँ से पहुँच योग्य है और कहाँ से नहीं। जाँच बाहरी सेवा के ज़रिए होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la raggiungibilità di un host da nodi in tutto il mondo — ping, HTTP, TCP, DNS o UDP, con scelta dei paesi. Vedi da dove la risorsa è raggiungibile e da dove no. La verifica passa per un servizio esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界中のノードからホストの到達性を確認します — ping、HTTP、TCP、DNS、UDP、国を選択可能。どこから到達できてどこからできないかが分かります。確認は外部サービス経由で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 세계 노드에서 호스트 도달성을 확인합니다 — ping, HTTP, TCP, DNS, UDP, 국가 선택 가능. 리소스가 어디서 도달 가능한지 아닌지 알 수 있습니다. 확인은 외부 서비스로 수행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a acessibilidade de um host a partir de nós pelo mundo — ping, HTTP, TCP, DNS ou UDP, com escolha de países. Você vê de onde o recurso é acessível e de onde não é. A verificação passa por um serviço externo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ana makinenin dünya genelindeki düğümlerden erişilebilirliğini denetler — ping, HTTP, TCP, DNS veya UDP, ülke seçimiyle. Kaynağın nereden erişilebildiğini, nereden erişilemediğini görürsünüz. Denetim harici bir servisle yapılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从全球各地的节点检测主机可达性——ping、HTTP、TCP、DNS 或 UDP，可选择国家/地区。可以看到资源从哪里可达、从哪里不可达。检测通过外部服务进行。"
          }
        }
      }
    },
    "Проверяет по одному эталонному узлу для каждого провайдера, сервиса и сервера push-уведомлений — отвечает ли он и не мешает ли сеть. Профиль соединения меняет вид TLS-рукопожатия: если один проходит, а другой обрывается, ограничение зависит от вида соединения.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص عقدة مرجعية واحدة لكل مزوّد وخدمة وخادم إشعارات دفع — هل يستجيب وهل تتدخل الشبكة. يغيّر ملف الاتصال مصافحة TLS: إذا نجحت واحدة وانقطعت أخرى، فالقيد يعتمد على نوع الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft je einen Referenzknoten pro Anbieter, Dienst und Push-Server – ob er antwortet und ob das Netz stört. Das Verbindungsprofil ändert den TLS-Handshake: Wenn einer durchkommt und ein anderer abbricht, hängt die Sperre vom Verbindungstyp ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks one reference node per provider, service and push-notification server — whether it responds and whether the network interferes. The connection profile changes the TLS handshake: if one passes and another is cut, the restriction depends on the connection type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba un nodo de referencia por cada proveedor, servicio y servidor de notificaciones push: si responde y si la red interfiere. El perfil de conexión cambia el saludo TLS: si uno pasa y otro se corta, la restricción depende del tipo de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie un nœud de référence par fournisseur, service et serveur de notifications push — s’il répond et si le réseau interfère. Le profil de connexion modifie la poignée de main TLS : si l’une passe et l’autre est coupée, la restriction dépend du type de connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रदाता, सेवा और पुश-नोटिफ़िकेशन सर्वर के लिए एक संदर्भ नोड जाँचता है — वह उत्तर देता है या नहीं और नेटवर्क बाधा डालता है या नहीं। कनेक्शन प्रोफ़ाइल TLS हैंडशेक बदलती है: यदि एक पास हो और दूसरा कटे, तो प्रतिबंध कनेक्शन के प्रकार पर निर्भर करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica un nodo di riferimento per ogni provider, servizio e server di notifiche push — se risponde e se la rete interferisce. Il profilo di connessione cambia l’handshake TLS: se uno passa e un altro viene interrotto, la restrizione dipende dal tipo di connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダ・サービス・プッシュ通知サーバーごとに 1 つの基準ノードを確認します — 応答するか、ネットワークが妨げていないか。接続プロファイルは TLS ハンドシェイクを変えます：一方が通り他方が切れる場合、制限は接続の種類に依存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자·서비스·푸시 알림 서버마다 기준 노드 하나를 확인합니다 — 응답 여부와 네트워크 간섭 여부. 연결 프로필은 TLS 핸드셰이크를 바꿉니다: 하나는 통과하고 다른 하나는 끊기면 제한은 연결 유형에 따라 달라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica um nó de referência por provedor, serviço e servidor de notificações push — se responde e se a rede interfere. O perfil de conexão muda o handshake TLS: se um passa e outro é cortado, a restrição depende do tipo de conexão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sağlayıcı, hizmet ve anlık bildirim sunucusu için bir referans düğümü denetler — yanıt verip vermediğini ve ağın engelleyip engellemediğini. Bağlantı profili TLS el sıkışmasını değiştirir: biri geçip diğeri kesiliyorsa kısıtlama bağlantı türüne bağlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个运营商、服务和推送通知服务器各检测一个参考节点——它是否响应、网络是否干扰。连接配置会改变 TLS 握手方式：若一个通过而另一个被中断，则该限制取决于连接类型。"
          }
        }
      }
    },
    "Проверяет по одному эталонному узлу для каждого провайдера, сервиса и сервера push-уведомлений — отвечает ли он и не мешает ли сеть. Сравнение с эталоном показывает, что именно недоступно.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص عقدة مرجعية واحدة لكل مزوّد وخدمة وخادم إشعارات دفع — هل يستجيب وهل تتدخل الشبكة. تُظهر المقارنة بالمرجع ما هو غير متاح بالضبط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft je einen Referenzknoten pro Anbieter, Dienst und Push-Server – ob er antwortet und ob das Netz stört. Der Vergleich mit einer Referenz zeigt genau, was nicht erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks one reference node per provider, service and push-notification server — whether it responds and whether the network interferes. Comparison with a reference shows exactly what is unreachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba un nodo de referencia por cada proveedor, servicio y servidor de notificaciones push: si responde y si la red interfiere. La comparación con la referencia muestra qué es exactamente lo inaccesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie un nœud de référence par fournisseur, service et serveur de notifications push — s’il répond et si le réseau interfère. La comparaison avec une référence montre exactement ce qui est inaccessible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रदाता, सेवा और पुश-नोटिफ़िकेशन सर्वर के लिए एक संदर्भ नोड जाँचता है — वह उत्तर देता है या नहीं और नेटवर्क बाधा डालता है या नहीं। संदर्भ से तुलना बताती है कि वास्तव में क्या अनुपलब्ध है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica un nodo di riferimento per ogni provider, servizio e server di notifiche push — se risponde e se la rete interferisce. Il confronto con un riferimento mostra esattamente cosa è irraggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダ・サービス・プッシュ通知サーバーごとに 1 つの基準ノードを確認します — 応答するか、ネットワークが妨げていないか。基準との比較で、何が到達不能かが正確に分かります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자·서비스·푸시 알림 서버마다 기준 노드 하나를 확인합니다 — 응답 여부와 네트워크 간섭 여부. 기준과 비교하면 정확히 무엇이 도달 불가인지 알 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica um nó de referência por provedor, serviço e servidor de notificações push — se responde e se a rede interfere. A comparação com uma referência mostra exatamente o que está inacessível."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sağlayıcı, hizmet ve anlık bildirim sunucusu için bir referans düğümü denetler — yanıt verip vermediğini ve ağın engelleyip engellemediğini. Referansla karşılaştırma, tam olarak neyin erişilemez olduğunu gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个运营商、服务和推送通知服务器各检测一个参考节点——它是否响应、网络是否干扰。与参考对比可显示到底什么不可达。"
          }
        }
      }
    },
    "Проверяет, доступны ли серверы push-уведомлений Apple и Google.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص ما إذا كانت خوادم الإشعارات الفورية من Apple وGoogle متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob die Push-Server von Apple und Google erreichbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether Apple and Google push notification servers are reachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si los servidores de notificaciones push de Apple y Google están accesibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie si les serveurs de notifications push d’Apple et de Google sont accessibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचता है कि Apple और Google के पुश सूचना सर्वर उपलब्ध हैं या नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se i server di notifiche push di Apple e Google sono raggiungibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple と Google のプッシュ通知サーバに接続できるかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple과 Google의 푸시 알림 서버에 연결되는지 확인해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se os servidores de notificações push da Apple e do Google estão acessíveis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ve Google’ın anlık bildirim sunucularına erişilip erişilemediğini denetler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测 Apple 和 Google 的推送通知服务器是否可达。"
          }
        }
      }
    },
    "Проверяет, какие TCP-порты открыты на хосте. Помогает узнать, какие сервисы доступны. Сканирование чужих хостов может расцениваться как недружественное действие.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص المنافذ TCP المفتوحة على المضيف. يساعد على معرفة الخدمات المتاحة. قد يُعدّ فحص مضيفي الآخرين عملاً غير ودّي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, welche TCP-Ports auf dem Host offen sind. Hilft herauszufinden, welche Dienste verfügbar sind. Das Scannen fremder Hosts kann als unfreundliche Handlung gewertet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks which TCP ports are open on a host. Helps find out which services are available. Scanning others' hosts may be treated as an unfriendly action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba qué puertos TCP están abiertos en el host. Ayuda a saber qué servicios están disponibles. Escanear hosts ajenos puede considerarse una acción hostil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie quels ports TCP sont ouverts sur l'hôte. Permet de connaître les services disponibles. Scanner les hôtes d'autrui peut être considéré comme une action hostile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचता है कि होस्ट पर कौन-से TCP पोर्ट खुले हैं। यह जानने में मदद करता है कि कौन-सी सेवाएँ उपलब्ध हैं। दूसरों के होस्ट स्कैन करना अमित्रवत कार्य माना जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla quali porte TCP sono aperte sull'host. Aiuta a scoprire quali servizi sono disponibili. La scansione di host altrui può essere considerata un'azione ostile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト上でどの TCP ポートが開いているかを確認します。利用可能なサービスを把握するのに役立ちます。他人のホストをスキャンすることは非友好的な行為とみなされる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에서 어떤 TCP 포트가 열려 있는지 확인합니다. 어떤 서비스를 사용할 수 있는지 파악하는 데 유용합니다. 타인의 호스트를 스캔하는 것은 비우호적인 행위로 간주될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica quais portas TCP estão abertas no host. Ajuda a descobrir quais serviços estão disponíveis. Escanear hosts de terceiros pode ser interpretado como uma ação hostil."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sunucuda hangi TCP portlarının açık olduğunu kontrol eder. Hangi hizmetlerin erişilebilir olduğunu öğrenmeye yardımcı olur. Başkalarının sunucularını taramak düşmanca bir eylem olarak değerlendirilebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查主机上哪些 TCP 端口开放。帮助了解有哪些服务可用。扫描他人主机可能被视为不友善行为。"
          }
        }
      }
    },
    "Проверяет, числится ли IP в почтовых чёрных списках (DNSBL). Полезно, если ваша почта попадает в спам.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص ما إذا كان IP مُدرَجاً في القوائم السوداء البريدية (DNSBL). مفيد إذا كان بريدك يصل إلى مجلد الرسائل غير المرغوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob eine IP in E-Mail-Blacklists (DNSBL) geführt wird. Nützlich, wenn Ihre E-Mails im Spam landen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks whether an IP is listed in email blacklists (DNSBL). Useful if your mail ends up in spam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si la IP figura en listas negras de correo (DNSBL). Útil si tu correo acaba en el spam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie si une IP figure dans des listes noires de messagerie (DNSBL). Utile si votre courrier atterrit dans les spams."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचता है कि क्या IP मेल की काली सूचियों (DNSBL) में है। यदि आपका मेल स्पैम में जाता है तो उपयोगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla se l'IP è presente nelle blacklist di posta (DNSBL). Utile se la tua posta finisce nello spam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IP がメールのブラックリスト（DNSBL）に登録されているかを確認します。メールが迷惑メール扱いされる場合に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IP가 메일 블랙리스트(DNSBL)에 등록되어 있는지 확인합니다. 메일이 스팸으로 분류될 때 유용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se o IP consta em listas negras de e-mail (DNSBL). Útil se seus e-mails caem no spam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir IP'nin posta kara listelerinde (DNSBL) yer alıp almadığını kontrol eder. E-postalarınız spam'e düşüyorsa yararlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 IP 是否被列入邮件黑名单（DNSBL）。当你的邮件被判为垃圾邮件时很有用。"
          }
        }
      }
    },
