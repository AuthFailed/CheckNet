    "Запускает одну проверку ограничений и возвращает вердикт с подробностями.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل فحصًا واحدًا للقيود ويعيد الحكم مع التفاصيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine einzelne Sperrprüfung aus und liefert einen Befund mit Details."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a single restriction check and returns a verdict with details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una comprobación de restricciones y devuelve un veredicto con los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une vérification des restrictions et renvoie un verdict détaillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिबंध की एक जाँच चलाता है और विवरण सहित निष्कर्ष देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue una singola verifica delle restrizioni e restituisce il verdetto con i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限のチェックを1つ実行し、判定と詳細を返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 확인을 하나 실행하고 판정과 세부 정보를 알려줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa uma verificação de restrições e retorna o veredito com os detalhes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir kısıtlama denetimi çalıştırır ve ayrıntılarıyla birlikte bir karar döndürür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行一项限制检测，并返回带详情的结论。"
          }
        }
      }
    },
    "Запускайте проверки по расписанию и ведите историю аптайма.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الفحوصات وفق جدول واحتفظ بسجل زمن التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe Prüfungen nach Zeitplan aus und behalte einen Uptime-Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run checks on a schedule and keep an uptime history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta comprobaciones programadas y mantén un historial de disponibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez des tests planifiés et conservez un historique de disponibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल पर जाँच चलाएँ और अपटाइम इतिहास रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui i controlli su pianificazione e mantieni uno storico di uptime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールでチェックを実行し、稼働時間の履歴を残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정에 맞춰 점검을 실행하고 가동 시간 기록을 유지하세요."
          }
        },
        "pt-BR": {
