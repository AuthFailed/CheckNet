    "Ограничение до TLS 1.2 — так выглядят соединения старых клиентов.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقييد حتى TLS 1.2 — هكذا تبدو اتصالات العملاء القدامى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt auf TLS 1.2 – so sehen Verbindungen älterer Clients aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capped at TLS 1.2 — this is how connections from older clients look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado a TLS 1.2: así son las conexiones de los clientes antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitation à TLS 1.2 — c’est ainsi que se présentent les connexions des anciens clients."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.2 तक की सीमा — पुराने क्लाइंट के कनेक्शन ऐसे दिखते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite a TLS 1.2: così appaiono le connessioni dei client meno recenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.2 までに制限した、古いクライアントと同様の接続です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.2까지로 제한한, 구형 클라이언트와 같은 형태의 연결이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado a TLS 1.2: é assim que aparecem as conexões de clientes antigos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 1.2 ile sınırlama — eski istemcilerin bağlantıları böyle görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制为 TLS 1.2，旧版客户端的连接就是这样。"
          }
        }
      }
    },
