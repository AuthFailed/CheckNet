    "Всё происходит на устройстве, наружу данные не уходят.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يجري على الجهاز؛ ولا تغادره أي بيانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles passiert auf dem Gerät; keine Daten verlassen es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It all happens on the device; no data leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo ocurre en el dispositivo; ningún dato sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout se passe sur l'appareil ; aucune donnée n'en sort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ डिवाइस पर होता है; कोई डेटा बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto avviene sul dispositivo; nessun dato esce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてデバイス上で行われ、データは外部に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것이 기기에서 이뤄지며 데이터는 밖으로 나가지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo acontece no dispositivo; nenhum dado sai dele."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey cihazda olur; hiçbir veri dışarı çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在设备上完成，数据不外传。"
          }
        }
      }
    },
