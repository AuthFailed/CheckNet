    "«Не сейчас» — это нормально: проверка просто не запустится.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«ليس الآن» أمرٌ طبيعي: لن يعمل الفحص فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nicht jetzt“ ist in Ordnung — die Prüfung läuft einfach nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Not now\" is fine — the check simply won't run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ahora no» está bien: la comprobación simplemente no se ejecutará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Pas maintenant » est acceptable — le test ne s'exécutera tout simplement pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "«अभी नहीं» ठीक है — जाँच बस नहीं चलेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Non ora» va bene: il controllo semplicemente non verrà eseguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今はしない」で大丈夫 — チェックが実行されないだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'나중에'도 괜찮습니다 — 점검이 실행되지 않을 뿐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Agora não» tudo bem: a verificação simplesmente não será executada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Şimdi değil\" sorun değil — kontrol yalnızca çalışmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“暂不”没关系——检查只是不会运行。"
          }
        }
      }
    },
