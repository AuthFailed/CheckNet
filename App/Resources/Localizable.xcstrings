    "Без него сканер сети, обзор устройств и Bonjour не работают. Включить можно в Настройках iOS.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدونه لا يعمل ماسح الشبكة ومستعرض الأجهزة و Bonjour. يمكن تفعيله من إعدادات iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne ihn funktionieren Netzwerkscanner, Gerätebrowser und Bonjour nicht. In den iOS-Einstellungen aktivierbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, the network scanner, device browser and Bonjour don't work. Turn it on in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él, el escáner de red, el explorador de dispositivos y Bonjour no funcionan. Actívalo en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans lui, le scanner réseau, l'explorateur d'appareils et Bonjour ne fonctionnent pas. Activez-le dans les Réglages iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बिना नेटवर्क स्कैनर, डिवाइस ब्राउज़र और Bonjour काम नहीं करते। इसे iOS सेटिंग्स में चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza di esso lo scanner di rete, l'esplora dispositivi e Bonjour non funzionano. Attivalo in Impostazioni iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがないと、ネットワークスキャナ、機器ブラウザ、Bonjour は動作しません。iOS の設定で有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한이 없으면 네트워크 스캐너, 기기 브라우저, Bonjour가 작동하지 않습니다. iOS 설정에서 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ele, o scanner de rede, o navegador de dispositivos e o Bonjour não funcionam. Ative nos Ajustes do iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olmadan ağ tarayıcısı, cihaz tarayıcısı ve Bonjour çalışmaz. iOS Ayarları'ndan açabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有它，网络扫描、设备浏览和 Bonjour 都无法工作。可在 iOS 设置中开启。"
          }
        }
      }
    },
