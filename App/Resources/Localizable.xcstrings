    "Сохранённые хосты и избранное синхронизируются через ваш iCloud между вашими устройствами.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved hosts and favorites sync via your iCloud across your devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的主机和收藏通过你的 iCloud 在各设备间同步。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hosts guardados y los favoritos se sincronizan a través de tu iCloud entre tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hôtes enregistrés et les favoris sont synchronisés via votre iCloud entre vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Hosts und Favoriten werden über deine iCloud zwischen deinen Geräten synchronisiert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したホストとお気に入りは、iCloud を通じてデバイス間で同期されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hosts salvos e os favoritos são sincronizados via iCloud entre seus dispositivos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 호스트와 즐겨찾기는 iCloud를 통해 기기 간에 동기화됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli host salvati e i preferiti si sincronizzano tramite il tuo iCloud tra i tuoi dispositivi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş sunucular ve favoriler, cihazlarınız arasında iCloud üzerinden senkronize edilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة المضيفات المحفوظة والمفضّلة عبر iCloud بين أجهزتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए होस्ट और पसंदीदा आपके iCloud के माध्यम से आपके डिवाइसों के बीच सिंक होते हैं।"
          }
        }
      }
    },
