    "Очень плохо — сеть захлёбывается под нагрузкой": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيئ جدًا — الشبكة تختنق تحت الحِمل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr schlecht – das Netz erstickt unter Last"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very bad — the network chokes under load"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy malo: la red se ahoga bajo carga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très mauvais — le réseau s’effondre sous charge"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत खराब — लोड में नेटवर्क घुट जाता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessimo — la rete si blocca sotto carico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に悪い — 負荷でネットワークが詰まります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매우 나쁨 — 부하에서 네트워크가 멈춤"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito ruim — a rede engasga sob carga"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok kötü — ağ yük altında tıkanıyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非常差——网络在负载下瘫痪"
          }
        }
      }
    },
