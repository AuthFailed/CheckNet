    "Синхронизация хостов через iCloud требует платного аккаунта разработчика и включается в соответствующей сборке.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب مزامنة المضيفين عبر iCloud حساب مطوّر مدفوعًا وتُفعّل في الإصدار المقابل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Host-Synchronisierung erfordert ein kostenpflichtiges Entwicklerkonto und wird in einem entsprechenden Build aktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud host sync needs a paid developer account and is enabled in a corresponding build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización de hosts por iCloud requiere una cuenta de desarrollador de pago y se activa en la compilación correspondiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation des hôtes via iCloud nécessite un compte développeur payant et s’active dans une version correspondante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud के ज़रिए होस्ट सिंक के लिए भुगतान वाला डेवलपर खाता चाहिए और यह संबंधित बिल्ड में सक्षम होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione degli host via iCloud richiede un account sviluppatore a pagamento e si attiva nella build corrispondente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud でのホスト同期には有料の開発者アカウントが必要で、対応するビルドで有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 호스트 동기화에는 유료 개발자 계정이 필요하며 해당 빌드에서 활성화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização de hosts via iCloud requer uma conta de desenvolvedor paga e é ativada em uma versão correspondente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ile ana makine eşitlemesi ücretli bir geliştirici hesabı gerektirir ve ilgili derlemede etkinleşir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iCloud 同步主机需要付费开发者账号，并在相应版本中启用。"
          }
        }
      }
    },
