    "Координаты не сохраняются и не покидают устройство.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُخزَّن الإحداثيات ولا تغادر الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinaten werden nicht gespeichert und verlassen das Gerät nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinates are not stored and never leave the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las coordenadas no se guardan ni salen del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coordonnées ne sont pas enregistrées et ne quittent jamais l'appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशांक न सहेजे जाते हैं और न डिवाइस से बाहर जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coordinate non vengono salvate né lasciano il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座標は保存されず、デバイスから出ることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌표는 저장되지 않으며 기기를 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As coordenadas não são armazenadas nem saem do dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinatlar saklanmaz ve cihazdan çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐标不会被存储，也绝不离开设备。"
          }
        }
      }
