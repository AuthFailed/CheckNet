    "Сканируется только ваша локальная сеть — ничего за её пределами.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص شبكتك المحلية فقط — لا شيء خارجها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dein lokales Netzwerk wird gescannt — nichts darüber hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your local network is scanned — nothing beyond it."
          }
        },
        "es": {
