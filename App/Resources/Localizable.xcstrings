    "Не закрывайте экран — идёт нагрузка": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُغلق الشاشة — التحميل جارٍ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm offen lassen – Last läuft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the screen open — load in progress"
          }
        },
        "es": {
