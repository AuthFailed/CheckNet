    "iOS не отдаёт приложениям данные о Wi-Fi-каналах и соседних сетях — это доступно только в версии для Mac (CoreWLAN).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمنح iOS التطبيقات بيانات قنوات Wi-Fi أو الشبكات المجاورة — تتوفر فقط في نسخة Mac (CoreWLAN)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gibt Apps keine Daten zu WLAN-Kanälen und Nachbarnetzen – das gibt es nur in der Mac-Version (CoreWLAN)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn’t give apps Wi-Fi channel or neighboring-network data — it’s only available in the Mac version (CoreWLAN)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no ofrece a las apps datos de canales Wi-Fi ni de redes vecinas: solo está disponible en la versión para Mac (CoreWLAN)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne fournit pas aux apps les données de canaux Wi-Fi ni des réseaux voisins — c’est disponible uniquement dans la version Mac (CoreWLAN)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ऐप्स को वाई-फ़ाई चैनल और आस-पास के नेटवर्क का डेटा नहीं देता — यह केवल Mac संस्करण (CoreWLAN) में उपलब्ध है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non fornisce alle app i dati sui canali Wi-Fi né sulle reti vicine: è disponibile solo nella versione per Mac (CoreWLAN)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS はアプリに Wi-Fi チャンネルや近隣ネットワークの情報を渡しません — Mac 版（CoreWLAN）でのみ利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 앱에 Wi-Fi 채널·주변 네트워크 데이터를 제공하지 않습니다 — Mac 버전(CoreWLAN)에서만 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não fornece aos apps dados de canais Wi-Fi nem de redes vizinhas — só está disponível na versão para Mac (CoreWLAN)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, uygulamalara Wi-Fi kanalı ve komşu ağ verilerini vermez — yalnızca Mac sürümünde (CoreWLAN) mevcuttur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不向应用提供 Wi-Fi 信道和邻近网络数据——仅 Mac 版本（CoreWLAN）可用。"
          }
        }
      }
    },
    "iOS не отдаёт приложениям уровень сигнала Wi-Fi (RSSI) — измерить его можно только на Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمنح iOS التطبيقات مستوى إشارة Wi-Fi (RSSI) — يمكن قياسه على Mac فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gibt Apps den WLAN-Signalpegel (RSSI) nicht – messen lässt er sich nur auf dem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn’t give apps the Wi-Fi signal level (RSSI) — you can only measure it on a Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no ofrece a las apps el nivel de señal Wi-Fi (RSSI): solo se puede medir en un Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne fournit pas aux apps le niveau de signal Wi-Fi (RSSI) — on ne peut le mesurer que sur un Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ऐप्स को वाई-फ़ाई सिग्नल स्तर (RSSI) नहीं देता — इसे केवल Mac पर मापा जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non fornisce alle app il livello del segnale Wi-Fi (RSSI): si può misurare solo su Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS はアプリに Wi-Fi 信号強度（RSSI）を渡しません — 測定できるのは Mac だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 앱에 Wi-Fi 신호 세기(RSSI)를 제공하지 않습니다 — Mac에서만 측정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não fornece aos apps o nível de sinal Wi-Fi (RSSI) — só é possível medir em um Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, uygulamalara Wi-Fi sinyal düzeyini (RSSI) vermez — yalnızca Mac’te ölçebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不向应用提供 Wi-Fi 信号强度（RSSI）——只能在 Mac 上测量。"
          }
        }
      }
    },
    "iOS не разрешает скачивать и запускать стороннее ядро. Проверка «через прокси» на iPhone использует встроенную Reality-пробу без загрузки ядра.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't allow downloading and running a third-party core. The \"via proxy\" check on iPhone uses a built-in Reality probe without loading a core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许下载和运行第三方内核。iPhone 上的「通过代理」检测使用内置 Reality 探测，无需加载内核。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permite descargar ni ejecutar un núcleo de terceros. La comprobación «a través del proxy» en el iPhone usa una prueba Reality integrada sin descargar el núcleo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n'autorise pas le téléchargement ni l'exécution d'un cœur tiers. Le test « via proxy » sur iPhone utilise une sonde Reality intégrée sans charger de cœur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS erlaubt nicht, einen fremden Core herunterzuladen und auszuführen. Der Test „über Proxy“ auf dem iPhone nutzt die integrierte Reality-Probe ohne Core-Download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS では外部コアのダウンロードや実行は許可されていません。iPhone での「Proxy 経由」チェックは、コアをダウンロードせずに内蔵の Reality プローブを使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não permite baixar e executar um núcleo de terceiros. A verificação \"via proxy\" no iPhone usa a sonda Reality integrada, sem baixar o núcleo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 외부 코어의 다운로드 및 실행을 허용하지 않습니다. iPhone의 「프록시 경유」 검사는 코어를 내려받지 않고 내장 Reality 프로브를 사용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non consente di scaricare ed eseguire un core esterno. Il test «tramite proxy» su iPhone usa la sonda Reality integrata senza scaricare il core."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, üçüncü taraf çekirdeğin indirilip çalıştırılmasına izin vermez. iPhone'da «proxy üzerinden» kontrolü, çekirdek indirmeden yerleşik Reality probunu kullanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح iOS بتنزيل وتشغيل نواة خارجية. يستخدم فحص «عبر Proxy» على iPhone مسبار Reality المدمج دون تنزيل النواة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS किसी बाहरी कोर को डाउनलोड और चलाने की अनुमति नहीं देता। iPhone पर «Proxy से» जाँच बिना कोर लोड किए बिल्ट-इन Reality प्रोब का उपयोग करती है।"
          }
        }
      }
    },
    "iOS отдаёт имя Wi-Fi-сети только приложениям с правом «Access Wi-Fi Information». Его подписывает лишь платный аккаунт разработчика, поэтому в этой сборке автоопределение сети выключено.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتيح iOS اسم شبكة Wi-Fi إلا للتطبيقات التي تملك صلاحية “Access Wi-Fi Information”، ولا يوقّع هذه الصلاحية سوى حساب مطوّر مدفوع، لذلك التحديد التلقائي للشبكة معطّل في هذه النسخة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gibt den Namen des Wi-Fi-Netzwerks nur an Apps mit der Berechtigung „Access Wi-Fi Information“ weiter. Diese kann nur ein kostenpflichtiger Entwickleraccount signieren, daher ist die automatische Netzwerkerkennung in diesem Build deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gives the Wi-Fi network name only to apps with the “Access Wi-Fi Information” entitlement, which only a paid developer account can sign. Automatic network detection is therefore turned off in this build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS solo facilita el nombre de la red Wi-Fi a las apps con el permiso “Access Wi-Fi Information”. Únicamente una cuenta de desarrollador de pago puede firmarlo, por eso en esta versión la detección automática de red está desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne communique le nom du réseau Wi-Fi qu’aux apps disposant du droit « Access Wi-Fi Information ». Seul un compte développeur payant peut le signer, la détection automatique du réseau est donc désactivée dans cette version."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, Wi-Fi नेटवर्क का नाम केवल उन ऐप्स को देता है जिनके पास \"Access Wi-Fi Information\" अधिकार है। इसे सिर्फ़ सशुल्क डेवलपर अकाउंट ही साइन कर सकता है, इसलिए इस बिल्ड में नेटवर्क की स्वतः-पहचान बंद है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS comunica il nome della rete Wi-Fi solo alle app con il diritto “Access Wi-Fi Information”. Lo firma unicamente un account sviluppatore a pagamento, quindi in questa build il rilevamento automatico della rete è disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS は「Access Wi-Fi Information」権限を持つAppにのみ Wi-Fi ネットワーク名を渡します。この権限は有料の開発者アカウントでしか署名できないため、このビルドではネットワークの自動判別をオフにしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 'Access Wi-Fi Information' 권한이 있는 앱에만 Wi-Fi 네트워크 이름을 제공해요. 이 권한은 유료 개발자 계정으로만 서명할 수 있어서, 이 빌드에서는 네트워크 자동 인식이 꺼져 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS informa o nome da rede Wi-Fi apenas para apps com o direito “Access Wi-Fi Information”. Ele só é assinado por uma conta de desenvolvedor paga, por isso nesta versão a detecção automática de rede está desativada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, Wi-Fi ağının adını yalnızca “Access Wi-Fi Information” yetkisi olan uygulamalara verir. Bu yetkiyi yalnızca ücretli geliştirici hesabı imzalayabildiğinden, bu sürümde ağın otomatik algılanması kapalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 仅向拥有“Access Wi-Fi Information”权限的 App 提供 Wi-Fi 网络名称，而该权限只能由付费开发者账户签名，因此此版本中已关闭网络自动识别。"
          }
        }
      }
    },
    "iOS отдаёт имя сети (SSID) только приложениям с доступом к геопозиции. Разрешите доступ, чтобы увидеть, к какой сети вы подключены.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only gives the network name (SSID) to apps with location access. Grant access to see which network you're connected to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 仅向拥有定位权限的应用提供网络名称（SSID）。请授予权限以查看当前连接的网络。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS solo entrega el nombre de la red (SSID) a las apps con acceso a la ubicación. Concede el acceso para ver a qué red estás conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne fournit le nom du réseau (SSID) qu'aux apps ayant accès à la localisation. Autorisez l'accès pour voir à quel réseau vous êtes connecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gibt den Netzwerknamen (SSID) nur Apps mit Standortzugriff preis. Erlaube den Zugriff, um zu sehen, mit welchem Netzwerk du verbunden bist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS は位置情報へのアクセス権を持つアプリにのみネットワーク名 (SSID) を提供します。接続中のネットワークを確認するにはアクセスを許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS só fornece o nome da rede (SSID) a apps com acesso à localização. Permita o acesso para ver a que rede você está conectado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 위치 접근 권한이 있는 앱에만 네트워크 이름(SSID)을 제공합니다. 어떤 네트워크에 연결되어 있는지 보려면 접근을 허용하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fornisce il nome della rete (SSID) solo alle app con accesso alla posizione. Consenti l'accesso per vedere a quale rete sei connesso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, ağ adını (SSID) yalnızca konum erişimi olan uygulamalara verir. Hangi ağa bağlı olduğunuzu görmek için erişime izin verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعطي iOS اسم الشبكة (SSID) فقط للتطبيقات التي لها وصول إلى الموقع الجغرافي. اسمح بالوصول لترى بأي شبكة أنت متصل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS नेटवर्क का नाम (SSID) केवल उन ऐप्स को देता है जिनके पास लोकेशन एक्सेस है। यह देखने के लिए कि आप किस नेटवर्क से जुड़े हैं, एक्सेस की अनुमति दें।"
          }
        }
      }
    },
    "iOS отдаёт название сети (SSID) только приложениям с доступом к геопозиции.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنح iOS اسم الشبكة (SSID) فقط للتطبيقات التي لديها إذن الموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gibt den Netzwerknamen (SSID) nur Apps mit Standortzugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gives the network name (SSID) only to apps with location access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entrega el nombre de red (SSID) solo a apps con acceso a la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne donne le nom du réseau (SSID) qu'aux apps ayant accès à la localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS नेटवर्क का नाम (SSID) केवल उन ऐप्स को देता है जिनके पास स्थान पहुँच है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fornisce il nome della rete (SSID) solo alle app con accesso alla posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS はネットワーク名（SSID）を位置情報アクセスを持つアプリにのみ渡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 위치 접근 권한이 있는 앱에만 네트워크 이름(SSID)을 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS fornece o nome da rede (SSID) apenas a apps com acesso à localização."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ağ adını (SSID) yalnızca konum erişimi olan uygulamalara verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 仅向拥有定位权限的应用提供网络名称（SSID）。"
          }
        }
      }
    },
